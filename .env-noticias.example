# ==============================================================================
# Configuración de Entorno: Noticias La Guía Linux (news.laguialinux.com)
# ==============================================================================
NUXT_PUBLIC_PLATFORM_SLUG=news
NUXT_PUBLIC_PLATFORM_DOMAIN=news.laguialinux.com
NUXT_PUBLIC_PLATFORM_NAME="Noticias La Guía Linux"
NUXT_PUBLIC_PLATFORM_TAGLINE="Actualidad, Distribuciones, Ciberseguridad y Open Source"

# Endpoint del Servidor Backend (API V2)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v2

# Acento de Color ('emerald' para Guías, 'orange' para Noticias)
NUXT_PUBLIC_THEME_ACCENT=orange

# Características Especializadas
NUXT_PUBLIC_FEATURES_TOOLS=false
NUXT_PUBLIC_FEATURES_CVE_ALERTS=true
NUXT_PUBLIC_FEATURES_KERNEL_WATCHER=true
